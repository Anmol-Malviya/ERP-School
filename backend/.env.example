NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/erp-school
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REFRESH_COOKIE_NAME=erp_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PORTAL_URL=http://localhost:3000
SUPERADMIN_URL=http://localhost:3001
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=erp-school
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_EMAIL=admin@schoolerp.local
